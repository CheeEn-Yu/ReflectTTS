#!/bin/bash
# vLLM-rollout GRPO RL for Step-Audio-2-mini (two-hop, tanh relative-CLSP reward).
#
# One 2-GPU job runs TWO processes talking over a file-RPC channel (--workdir):
#   - trainer  (conda env $STEP_ENV, GPU A): train/rl_vllm/train_rl_vllm.py
#   - sidecar  (conda env $VLLM_ENV, GPU B): train/rl_vllm/vllm_rollout_server.py
# Weight sync between them is `nccl` (default) or `disk` (--sync).
#
# Smoke:  STEPS=3 LIMIT=8 G=4 sbatch -p dev -t 00:50:00 scripts/train/run_rl_twohop.sbatch
# Paper:  SPEAKER_RAG=1 sbatch scripts/train/run_rl_twohop.sbatch
# Disk sync instead of nccl:  SYNC=disk sbatch scripts/train/run_rl_twohop.sbatch
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --gpus-per-node 2
# NOTE: pass your Slurm account on the command line:  sbatch -A <account> ...
#SBATCH -p normal
#SBATCH --time=36:00:00
#SBATCH -o out/slurm/%x_%j.out
#SBATCH -e out/slurm/%x_%j.err
#SBATCH -J rl_vllm_twohop
#SBATCH --requeue
set -uo pipefail

REPO="${SLURM_SUBMIT_DIR:-$PWD}"
cd "$REPO"
mkdir -p out/slurm

# vLLM "view" of the policy (Qwen2-shaped Step-Audio-2-mini) the sidecar loads.
# Build once if missing:  conda activate step; python -m train.rl_vllm.make_qwen2_view
VIEW="${VIEW:-out/qwen2_view/step-audio-2-mini-qwen2}"
# The two-hop JSONL carries clsp_v1/wer_v1 for the relative-improvement reward.
TRAIN_JSONL="${TRAIN_JSONL:-data/rl/paraspeechcaps_en_twohop/train.jsonl}"
STEP_ENV="${STEP_ENV:-step}"
VLLM_ENV="${VLLM_ENV:-vllm}"

# ---- preflight: fail early with a clear message instead of mid-run ----
[ -d "$VIEW" ]        || { echo "FATAL: vLLM view missing: $VIEW (build via make_qwen2_view or symlink it)"; exit 1; }
[ -f "$TRAIN_JSONL" ] || { echo "FATAL: train data missing: $TRAIN_JSONL"; exit 1; }
[ -d "Step-Audio2/Step-Audio-2-mini" ] || { echo "FATAL: model missing: Step-Audio2/Step-Audio-2-mini"; exit 1; }

# Per-attempt workdir so a requeued leg starts with a clean file-RPC channel;
# the trainer auto-resumes from the latest ckpt in OUT_DIR.
WD="out/rl/vllm_twohop/rpc_${SLURM_JOB_ID}_${SLURM_RESTART_COUNT:-0}"
rm -rf "$WD"; mkdir -p "$WD"

# Split the two allocated GPUs: trainer on the first, sidecar on the second.
IFS=',' read -ra GPUS <<< "${CUDA_VISIBLE_DEVICES:-0,1}"
GPU_TRAIN="${GPUS[0]}"
GPU_SIDE="${GPUS[1]:-${GPUS[0]}}"
SYNC="${SYNC:-nccl}"
NCCL_PORT=$((29500 + RANDOM % 3000))
echo "START $(date '+%F %T')  trainer GPU=$GPU_TRAIN  sidecar GPU=$GPU_SIDE  sync=$SYNC port=$NCCL_PORT  WD=$WD"
echo "ENVS  trainer=$STEP_ENV  sidecar=$VLLM_ENV"

# ---- launch vLLM sidecar ----
SIDECAR_LOG="out/slurm/sidecar_${SLURM_JOB_ID}.log"
(
  module load miniconda3 2>/dev/null || true
  eval "$(conda shell.bash hook)"
  conda activate "$VLLM_ENV" || exit 1
  cd "$REPO"; export PYTHONPATH="$PWD"; export CUDA_VISIBLE_DEVICES="$GPU_SIDE"
  export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
  python -m train.rl_vllm.vllm_rollout_server \
      --view_dir "$VIEW" --workdir "$WD" \
      --gpu_mem_util "${GPU_MEM_UTIL:-0.85}" --max_model_len "${MAX_MODEL_LEN:-8192}"
) > "$SIDECAR_LOG" 2>&1 &
SIDE_PID=$!

cleanup() { kill "$SIDE_PID" 2>/dev/null; wait "$SIDE_PID" 2>/dev/null; }
trap cleanup EXIT

# Catch a missing/broken rollout environment immediately instead of letting the
# trainer wait for its full RPC timeout.
SIDECAR_READY_TIMEOUT="${SIDECAR_READY_TIMEOUT:-600}"
READY_DEADLINE=$((SECONDS + SIDECAR_READY_TIMEOUT))
while [ ! -f "$WD/ready" ]; do
  if ! kill -0 "$SIDE_PID" 2>/dev/null; then
    echo "FATAL: vLLM sidecar exited before becoming ready. Last log lines:"
    tail -n 80 "$SIDECAR_LOG"
    wait "$SIDE_PID"
    exit 1
  fi
  if (( SECONDS >= READY_DEADLINE )); then
    echo "FATAL: vLLM sidecar was not ready after ${SIDECAR_READY_TIMEOUT}s. Last log lines:"
    tail -n 80 "$SIDECAR_LOG"
    exit 1
  fi
  sleep 2
done

# ---- run trainer ----
# Defaults reproduce the paper run: precomputed v1, critique regenerated by the
# current policy each step, and GRPO applied to v2. Environment booleans accept
# 1/true/yes/on; use 0 to disable a default (for example ON_POLICY_CRITIQUE=0).
enabled() {
  case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

TRAINER_ARGS=()
[[ -n "${LIMIT:-}" ]] && TRAINER_ARGS+=(--limit "$LIMIT")
enabled "${WER_ABSOLUTE:-0}" && TRAINER_ARGS+=(--wer_absolute)
enabled "${WER_HARD_GATE:-0}" && TRAINER_ARGS+=(--wer_hard_gate)
enabled "${ON_POLICY_CRITIQUE:-1}" && TRAINER_ARGS+=(--on_policy_critique)
enabled "${ON_POLICY_V1:-0}" && TRAINER_ARGS+=(--on_policy_v1)
if enabled "${SPEAKER_RAG:-0}"; then
  TRAINER_ARGS+=(--speaker_rag
                 --speaker_emb_cache "${SPEAKER_EMB_CACHE:-out/rl/speaker_emb_cache.pt}"
                 --clsp_model "${CLSP_MODEL:-yfyeung/CLSP}")
fi
[[ -n "${V1_TEMPERATURE:-}" ]] && TRAINER_ARGS+=(--v1_temperature "$V1_TEMPERATURE")
[[ -n "${V1_MAX_NEW_TOKENS:-}" ]] && TRAINER_ARGS+=(--v1_max_new_tokens "$V1_MAX_NEW_TOKENS")
enabled "${MIXED_GROUP:-0}" && TRAINER_ARGS+=(--mixed_group)
enabled "${VERIFY_SYNC:-0}" && TRAINER_ARGS+=(--verify_sync)

(
  module load miniconda3 2>/dev/null || true
  eval "$(conda shell.bash hook)"
  conda activate "$STEP_ENV" || exit 1
  cd "$REPO"; export PYTHONPATH="$PWD"; export CUDA_VISIBLE_DEVICES="$GPU_TRAIN"
  export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
  python -m train.rl_vllm.train_rl_vllm \
      --workdir "$WD" \
      --output_dir "${OUT_DIR:-out/rl/vllm_twohop/run_${SLURM_JOB_ID}_${SYNC}}" \
      --train_jsonl "$TRAIN_JSONL" \
      --policy_path "${POLICY_PATH:-Step-Audio-2-mini}" \
      --steps "${STEPS:-1000}" \
      --G "${G:-16}" \
      --micro_batch "${MICRO_BATCH:-1}" --grad_accum "${GRAD_ACCUM:-1}" \
      --lr "${LR:-1e-4}" --warmup_steps "${WARMUP:-20}" --lr_min_ratio "${LR_MIN_RATIO:-0.1}" \
      --kl_coef "${KL:-0.05}" --ckpt_every "${CKPT_EVERY:-100}" \
      --grad_clip "${GRAD_CLIP:-1.0}" --clip_advantage "${CLIP_ADV:-5.0}" \
      --temperature "${TEMPERATURE:-0.9}" --max_new_tokens "${MAX_NEW_TOKENS:-512}" \
      --lora_r "${LORA_R:-16}" --lora_alpha "${LORA_ALPHA:-32}" \
      --scorer_device cuda:0 \
      --beta_clsp "${BETA_CLSP:-0.5}" --lambda_improve "${LAMBDA_IMPROVE:-1.0}" \
      --improve_fn "${IMPROVE_FN:-tanh}" --improve_scale "${IMPROVE_SCALE:-10.0}" \
      --wer_penalty "${WER_PENALTY:-0.5}" --wer_gate "${WER_GATE:-0.10}" --gate_penalty "${GATE_PENALTY:--1.0}" \
      --sync "$SYNC" --nccl_port "$NCCL_PORT" --seed "${SEED:-0}" \
      --critique_mode "${CRITIQUE_MODE:-static}" --max_think_tokens "${MAX_THINK_TOKENS:-256}" \
      "${TRAINER_ARGS[@]}"
)
RC=$?
echo "END $(date '+%F %T')  trainer rc=$RC"
exit $RC
